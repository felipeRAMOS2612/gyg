---
import { site } from '../lib/site';

const year = new Date().getFullYear();
const links = [
  { href: '#compromiso', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="border-t border-white/10 bg-ink-950">
  <div class="shell flex flex-col gap-8 py-12 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-3">
      <img src="/logo-removebg.png" alt="" width="44" height="44" class="h-10 w-auto" />
      <div>
        <p class="font-display text-sm font-bold uppercase tracking-tight text-white">
          {site.name}
        </p>
        <p class="mt-0.5 text-sm text-ink-400">{site.tagline}</p>
      </div>
    </div>

    <nav class="flex flex-wrap gap-x-7 gap-y-2" aria-label="Navegación del pie de página">
      {
        links.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center text-sm text-ink-300 transition hover:text-white">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-white/10">
    <p class="shell py-6 text-center text-xs text-ink-500">
      &copy; {year} gyg-ingenieria.com — Todos los derechos reservados.
    </p>
  </div>
</footer>
