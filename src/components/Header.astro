---
import Icon from './Icon.astro';
import { site } from '../lib/site';

const links = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#compromiso', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300"
>
  <div class="shell flex h-20 items-center justify-between gap-6">
    <a href="#inicio" class="flex min-h-11 items-center gap-3" aria-label={`${site.name} — ir al inicio`}>
      <img src="/logo-removebg.png" alt="" width="48" height="48" class="h-10 w-auto" />
      <span
        data-header-wordmark
        class="hidden font-display text-base font-bold uppercase leading-none tracking-tight text-white sm:block"
      >
        G&amp;G Ingeniería
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            class="group relative py-1 text-[0.9rem] font-medium text-white/75 transition-colors hover:text-white"
          >
            {link.label}
            <span class="absolute inset-x-0 -bottom-0.5 h-0.5 origin-left scale-x-0 bg-accent-500 transition-transform duration-300 group-hover:scale-x-100" />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-md bg-accent-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-600 sm:inline-flex"
      >
        <Icon name="whatsapp" class="h-4 w-4" />
        Solicitar cotización
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-white/25 text-white transition hover:bg-white/10 lg:hidden"
      >
        <span class="sr-only">Abrir menú</span>
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <!-- Reading progress. Driven by a CSS scroll timeline; inert where unsupported. -->
  <div class="absolute inset-x-0 bottom-0 h-0.5 bg-transparent">
    <div class="scroll-progress h-full w-full bg-accent-500"></div>
  </div>
</header>

<!--
  The panel is a sibling of <header> on purpose. The header applies
  backdrop-filter once the page is scrolled, and an element with a backdrop
  filter becomes the containing block for its fixed-position descendants — which
  would clip this overlay to the 80px header instead of the viewport.
-->
<div
  id="mobile-menu"
  data-menu-panel
  hidden
  class="fixed inset-0 z-50 bg-ink-900 lg:hidden"
>
  <div class="flex h-20 items-center justify-between gap-6 px-5">
    <span class="font-display text-base font-bold uppercase tracking-tight text-white">
      G&amp;G Ingeniería
    </span>
    <button
      type="button"
      data-menu-close
      class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-white/25 text-white transition hover:bg-white/10"
    >
      <span class="sr-only">Cerrar menú</span>
      <Icon name="close" class="h-5 w-5" />
    </button>
  </div>

  <nav class="flex flex-col px-5 pt-4" aria-label="Navegación móvil">
    {
      links.map((link, index) => (
        <a
          href={link.href}
          data-menu-item
          class="flex items-baseline justify-between border-b border-white/10 py-5 font-display text-2xl font-bold text-white"
        >
          <span>{link.label}</span>
          <span class="font-sans text-xs font-semibold tracking-[0.2em] text-ink-400">
            0{index + 1}
          </span>
        </a>
      ))
    }

    <a
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-accent-500 px-6 py-4 font-semibold text-white"
    >
      <Icon name="whatsapp" class="h-5 w-5" />
      {site.phone}
    </a>

    <a
      href={`mailto:${site.email}`}
      class="mt-3 inline-flex items-center justify-center gap-2 rounded-md border border-white/20 px-6 py-4 text-sm font-medium text-white"
    >
      <Icon name="mail" class="h-5 w-5" />
      {site.email}
    </a>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  // The header floats over the dark hero at rest and turns into a solid white
  // bar once the page scrolls past it, so nav text has to invert with it.
  const syncHeader = () => {
    if (!header) return;
    const scrolled = window.scrollY > 24;
    header.classList.toggle('bg-white/95', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
    header.classList.toggle('border-ink-200', scrolled);

    header.querySelectorAll<HTMLElement>('[data-nav-link]').forEach((link) => {
      link.classList.toggle('text-white/75', !scrolled);
      link.classList.toggle('text-ink-600', scrolled);
    });

    const wordmark = header.querySelector<HTMLElement>('[data-header-wordmark]');
    wordmark?.classList.toggle('text-white', !scrolled);
    wordmark?.classList.toggle('text-ink-900', scrolled);

    if (toggle) {
      toggle.classList.toggle('text-white', !scrolled);
      toggle.classList.toggle('border-white/25', !scrolled);
      toggle.classList.toggle('text-ink-900', scrolled);
      toggle.classList.toggle('border-ink-200', scrolled);
    }
  };

  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });

  const setMenu = (open: boolean) => {
    if (!panel || !toggle) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) closeButton?.focus();
  };

  // `hidden` is typed as boolean | "until-found", so compare rather than negate.
  toggle?.addEventListener('click', () => setMenu(panel?.hidden !== false));
  closeButton?.addEventListener('click', () => setMenu(false));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && panel.hidden === false) setMenu(false);
  });

  // Underline the nav entry whose section is currently in view.
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') ?? ''))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => {
            const active = link.getAttribute('href') === `#${entry.target.id}`;
            link.querySelector('span')?.classList.toggle('scale-x-100', active);
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }
</script>
